# Generate the salt and hash with node scripts/setup.mjs. Never store a plaintext password.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
PUBLIC_ORIGIN=https://tournaments.example.com
DATABASE_PATH=data/tournament.sqlite
# Production: NODE_ENV=production, HOST=0.0.0.0, and TRUST_PROXY=true (only behind Caddy).

SITE_ADDRESS=tournaments.example.com
