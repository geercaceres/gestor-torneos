# Generar salt y hash con node scripts/setup.mjs. Nunca usar contraseña en texto plano.
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
PUBLIC_ORIGIN=https://torneo.example.com
DATABASE_PATH=data/torneo.sqlite
# Producción: NODE_ENV=production, HOST=0.0.0.0 y TRUST_PROXY=true (solo detrás de Caddy).

SITE_ADDRESS=torneo.example.com
